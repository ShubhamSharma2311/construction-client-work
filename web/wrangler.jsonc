{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The website: the built app, plus /api/* forwarded to the API on Cloud Run.
  "name": "sawariya-seth",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any address the app routes itself (/trips/41, /reset-password) gets index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // API_ORIGIN is passed at deploy time (deploy/web.sh reads it from Cloud Run), and
  // PROXY_SECRET is a Worker secret copied from Google Secret Manager; neither lives here.
  "observability": { "enabled": true }
}
