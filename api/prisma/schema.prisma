generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model AuditLog {
  id       BigInt      @id @default(autoincrement())
  entity   String
  entityId String
  action   AuditAction
  before   Json?
  after    Json?
  at       DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
}

model IdempotencyKey {
  key          String   @id
  route        String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  refreshTokens RefreshToken[]
}

/// One row per issued refresh token; a login and all its rotations share a familyId.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([familyId])
  @@index([userId])
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  ip        String
  username  String
  succeeded Boolean
  at        DateTime @db.Timestamptz(3)

  @@index([ip, at])
}

/// Single row (id = 1): the business-wide settings every dated entry is checked against.
model Setting {
  id                 Int      @id @default(1)
  businessName       String
  businessStartDate  DateTime @db.Date
  openingCashPaise   Int      @default(0)
  openingOnlinePaise Int      @default(0)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  /// Lower-cased, space-collapsed name used for search and duplicate hints.
  nameKey   String
  phone     String?
  village   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([nameKey])
}

model Tractor {
  id            Int      @id @default(autoincrement())
  /// Upper-case, no spaces or dashes, e.g. RJ19AB1234.
  regNumber     String   @unique
  label         String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  defaultDriver Driver?
}

model Driver {
  id               Int                @id @default(autoincrement())
  name             String
  phone            String?
  joinedOn         DateTime           @db.Date
  leftOn           DateTime?          @db.Date
  /// Each tractor is the usual tractor of at most one driver.
  defaultTractorId Int?               @unique
  defaultTractor   Tractor?           @relation(fields: [defaultTractorId], references: [id])
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  salaryRates      DriverSalaryRate[]
}

model DriverSalaryRate {
  id            Int      @id @default(autoincrement())
  driverId      Int
  driver        Driver   @relation(fields: [driverId], references: [id])
  monthlyPaise  Int
  /// First day of the month the rate starts applying.
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([driverId, effectiveFrom])
}

model Khet {
  id        Int      @id @default(autoincrement())
  name      String
  nameKey   String   @unique
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Labourer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Partner {
  id               Int      @id @default(autoincrement())
  name             String
  /// Profit share in basis points (33.33% = 3333); null until agreed.
  shareBasisPoints Int?
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}
