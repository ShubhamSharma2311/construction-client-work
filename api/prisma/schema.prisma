generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model AuditLog {
  id       BigInt      @id @default(autoincrement())
  entity   String
  entityId String
  action   AuditAction
  before   Json?
  after    Json?
  at       DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
}

model IdempotencyKey {
  key          String   @id
  route        String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model User {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  passwordHash   String
  /// Where "forgot password" sends the reset link; none set means no reset by email.
  email          String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
}

/// A "forgot password" link: only the token's SHA-256 is stored, and it works once.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @db.Timestamptz(3)

  @@index([userId, createdAt])
}

/// One row per issued refresh token; a login and all its rotations share a familyId.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([familyId])
  @@index([userId])
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  ip        String
  username  String
  succeeded Boolean
  at        DateTime @db.Timestamptz(3)

  @@index([ip, at])
}

/// Single row (id = 1): the business-wide settings every dated entry is checked against.
model Setting {
  id                 Int      @id @default(1)
  businessName       String
  businessStartDate  DateTime @db.Date
  openingCashPaise   Int      @default(0)
  openingOnlinePaise Int      @default(0)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model Customer {
  id        Int               @id @default(autoincrement())
  name      String
  /// Lower-cased, space-collapsed name used for search and duplicate hints.
  nameKey   String
  phone     String?
  village   String?
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  trips     Trip[]
  payments  CustomerPayment[]

  @@index([nameKey])
}

model Tractor {
  id            Int           @id @default(autoincrement())
  /// Upper-case, no spaces or dashes, e.g. RJ19AB1234.
  regNumber     String        @unique
  label         String
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  defaultDriver Driver?
  trips         Trip[]
  expenses      Expense[]
  loans         TractorLoan[]
}

model Driver {
  id               Int                @id @default(autoincrement())
  name             String
  phone            String?
  joinedOn         DateTime           @db.Date
  leftOn           DateTime?          @db.Date
  /// Each tractor is the usual tractor of at most one driver.
  defaultTractorId Int?               @unique
  defaultTractor   Tractor?           @relation(fields: [defaultTractorId], references: [id])
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  salaryRates      DriverSalaryRate[]
  trips            Trip[]
  expenses         Expense[]
  accruals         DriverAccrual[]
  payments         DriverPayment[]
}

model DriverSalaryRate {
  id            Int      @id @default(autoincrement())
  driverId      Int
  driver        Driver   @relation(fields: [driverId], references: [id])
  monthlyPaise  Int
  /// First day of the month the rate starts applying.
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([driverId, effectiveFrom])
}

model Khet {
  id        Int      @id @default(autoincrement())
  name      String
  nameKey   String   @unique
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  trips     Trip[]
}

model Labourer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  expenses  Expense[]
}

model Partner {
  id               Int          @id @default(autoincrement())
  name             String
  /// Profit share in basis points (33.33% = 3333); null until agreed.
  shareBasisPoints Int?
  notes            String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  txns             PartnerTxn[]
}

enum PayMode {
  CASH
  ONLINE
}

enum TripKind {
  TRIP
  /// The customer's due carried over from the paper register, dated the business start.
  OPENING_BALANCE
}

enum CustomerPaymentKind {
  PAYMENT
  /// Forgiven amount (discount at settlement); no money moves.
  WRITE_OFF
}

model Trip {
  id              Int                 @id @default(autoincrement())
  kind            TripKind            @default(TRIP)
  tripDate        DateTime            @db.Date
  customerId      Int
  customer        Customer            @relation(fields: [customerId], references: [id])
  driverId        Int?
  driver          Driver?             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  tractorId       Int?
  tractor         Tractor?            @relation(fields: [tractorId], references: [id], onDelete: Restrict)
  khetId          Int?
  khet            Khet?               @relation(fields: [khetId], references: [id], onDelete: Restrict)
  amountPaise     Int
  /// Kept equal to the sum of this trip's allocations by a database trigger.
  receivedPaise   Int                 @default(0)
  quantityNote    String?
  notes           String?
  deletedAt       DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  allocations     PaymentAllocation[]
  /// Money taken when this trip was delivered; it moves with the trip's date.
  deliveryPayment CustomerPayment?    @relation("DeliveryPayment")

  @@index([customerId, tripDate])
  @@index([tripDate])
}

model CustomerPayment {
  id             Int                 @id @default(autoincrement())
  customerId     Int
  customer       Customer            @relation(fields: [customerId], references: [id])
  paidOn         DateTime            @db.Date
  kind           CustomerPaymentKind @default(PAYMENT)
  /// Null exactly when kind is WRITE_OFF.
  mode           PayMode?
  amountPaise    Int
  /// Kept equal to the sum of this payment's allocations by a database trigger.
  allocatedPaise Int                 @default(0)
  reference      String?
  notes          String?
  /// Set when the money was taken at a trip's delivery rather than paid later.
  deliveryTripId Int?                @unique
  deliveryTrip   Trip?               @relation("DeliveryPayment", fields: [deliveryTripId], references: [id])
  deletedAt      DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  allocations    PaymentAllocation[]

  @@index([customerId, paidOn])
  @@index([paidOn])
}

/// How much of one payment settles one trip. Rows are inserted or deleted, never updated.
model PaymentAllocation {
  id          Int             @id @default(autoincrement())
  paymentId   Int
  payment     CustomerPayment @relation(fields: [paymentId], references: [id])
  tripId      Int
  trip        Trip            @relation(fields: [tripId], references: [id])
  amountPaise Int
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([paymentId, tripId])
  @@index([tripId])
}

enum ExpenseCategory {
  LABOUR
  DIESEL
  ROYALTY
  POLICE
  OTHER
  EMERGENCY
  TRACTOR_SERVICE
  TRACTOR_EMI
}

/// Money the business paid out. Which optional columns are filled depends on the category;
/// CHECK constraints in the migration hold those rules.
model Expense {
  id            Int             @id @default(autoincrement())
  category      ExpenseCategory
  spentOn       DateTime        @db.Date
  amountPaise   Int
  mode          PayMode
  driverId      Int?
  driver        Driver?         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  tractorId     Int?
  tractor       Tractor?        @relation(fields: [tractorId], references: [id], onDelete: Restrict)
  labourerId    Int?
  labourer      Labourer?       @relation(fields: [labourerId], references: [id], onDelete: Restrict)
  /// Diesel only: litres in millilitres, so 45.5 L is 45500.
  dieselMl      Int?
  /// Tractor service only: hour-meter reading in whole hours.
  hourMeter     Int?
  /// Royalty only: the period the payment covers.
  periodFrom    DateTime?       @db.Date
  periodTo      DateTime?       @db.Date
  reference     String?
  notes         String?
  /// EMI only: the loan paid, and the instalment month (null for a foreclosure payment).
  tractorLoanId Int?
  tractorLoan   TractorLoan?    @relation(fields: [tractorLoanId], references: [id], onDelete: Restrict)
  emiMonth      DateTime?       @db.Date
  /// EMI only: the part of amountPaise that was a late fee.
  lateFeePaise  Int?
  deletedAt     DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([spentOn])
  @@index([category, spentOn])
  @@index([tractorId, spentOn])
  @@index([driverId, spentOn])
}

enum LoanClosure {
  PAID_OFF
  FORECLOSED
}

/// A loan taken for a tractor, paid back in fixed monthly instalments (EMI).
model TractorLoan {
  id                Int          @id @default(autoincrement())
  tractorId         Int
  tractor           Tractor      @relation(fields: [tractorId], references: [id], onDelete: Restrict)
  lender            String
  emiPaise          Int
  /// Day of the month the EMI falls due; 1-28 so every month has it.
  emiDay            Int
  /// First day of the month of the first instalment.
  firstEmiMonth     DateTime     @db.Date
  totalInstallments Int
  closedOn          DateTime?    @db.Date
  closedReason      LoanClosure?
  notes             String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  payments          Expense[]

  @@index([tractorId])
}

enum DriverAccrualKind {
  /// Salary earned for a closed month.
  MONTH_SALARY
  BONUS
  /// What the driver was owed (positive) or held as advance (negative) in the old register.
  OPENING_BALANCE
}

enum DriverPaymentType {
  ADVANCE
  SALARY
  BONUS
}

/// Money a driver has earned. Balance = earned - paid; positive means the owner owes the driver.
model DriverAccrual {
  id           Int               @id @default(autoincrement())
  driverId     Int
  driver       Driver            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  kind         DriverAccrualKind
  /// MONTH_SALARY only: first day of the month earned.
  month        DateTime?         @db.Date
  /// The day it counts in the ledger: month end for salary, the day given for others.
  accruedOn    DateTime          @db.Date
  amountPaise  Int
  note         String?
  deletedAt    DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  bonusPayment DriverPayment?

  @@index([driverId, accruedOn])
}

/// Money paid to a driver: an advance during the month, the salary, or a bonus.
model DriverPayment {
  id             Int               @id @default(autoincrement())
  driverId       Int
  driver         Driver            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  paidOn         DateTime          @db.Date
  type           DriverPaymentType
  amountPaise    Int
  mode           PayMode
  /// The month this payment is for, when the owner says so.
  forMonth       DateTime?         @db.Date
  /// BONUS only: the earning recorded together with this payment.
  bonusAccrualId Int?              @unique
  bonusAccrual   DriverAccrual?    @relation(fields: [bonusAccrualId], references: [id], onDelete: Restrict)
  notes          String?
  deletedAt      DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([driverId, paidOn])
  @@index([paidOn])
}

enum PartnerTxnDirection {
  PAID_TO_PARTNER
  RECEIVED_FROM_PARTNER
}

/// Money between the business and a partner: profit share or drawings paid out, or capital put in.
model PartnerTxn {
  id          Int                 @id @default(autoincrement())
  partnerId   Int
  partner     Partner             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  txnDate     DateTime            @db.Date
  direction   PartnerTxnDirection
  amountPaise Int
  mode        PayMode
  notes       String?
  deletedAt   DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@index([partnerId, txnDate])
  @@index([txnDate])
}
