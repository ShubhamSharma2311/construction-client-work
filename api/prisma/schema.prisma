generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model AuditLog {
  id       BigInt      @id @default(autoincrement())
  entity   String
  entityId String
  action   AuditAction
  before   Json?
  after    Json?
  at       DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
}

model IdempotencyKey {
  key          String   @id
  route        String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  refreshTokens RefreshToken[]
}

/// One row per issued refresh token; a login and all its rotations share a familyId.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([familyId])
  @@index([userId])
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  ip        String
  username  String
  succeeded Boolean
  at        DateTime @db.Timestamptz(3)

  @@index([ip, at])
}
