generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model AuditLog {
  id       BigInt      @id @default(autoincrement())
  entity   String
  entityId String
  action   AuditAction
  before   Json?
  after    Json?
  at       DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
}

model IdempotencyKey {
  key          String   @id
  route        String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}
