{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The whole app on Cloudflare: the built website, and /api/* served by the Ledger
  // Durable Object, which holds the ledger's SQLite database.
  "name": "sawariya-seth-construction-materials",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Addresses the app routes itself (/trips/41, /reset-password) get index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }],
  // The schema migrations are bundled as text and applied by the Ledger on start.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // The live address is set at deploy time; this one is for wrangler dev.
  "vars": { "APP_URL": "http://localhost:8787" },
  "observability": { "enabled": true },
}
