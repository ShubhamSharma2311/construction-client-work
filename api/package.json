{
  "name": "sawariya-seth-construction-materials-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#prisma/*": {
      "workerd": "./src/generated/prisma-workerd/*",
      "default": "./src/generated/prisma/*"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "create-owner": "tsx --env-file=.env src/cli/create-owner.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gate": "npm run typecheck && npm run lint && npm run test:coverage",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "dev:worker": "npm --prefix ../web run build && wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "setup-owner": "bash scripts/setup-owner.sh"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "hono": "4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "2.1.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "better-sqlite3": "12.11.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
