{
  "name": "sand-trip-ledger-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "create-owner": "tsx --env-file=.env src/cli/create-owner.ts",
    "openapi": "tsx src/cli/openapi.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gate": "npm run typecheck && npm run lint && npm run test:coverage",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev && prisma generate",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "9.9.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
