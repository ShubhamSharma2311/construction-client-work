# Settings for the deploy scripts. Nothing here is secret: secrets live in Google Secret
# Manager and are created by gcp-setup.sh. Replace every "set-me" before the first run.

# The Google Cloud project (its ID, from the console's project picker).
GCP_PROJECT=set-me
# Mumbai.
GCP_REGION=asia-south1

# The website's address: https://sawariya-seth.<your-subdomain>.workers.dev
# The subdomain is on the Cloudflare dashboard under Workers & Pages.
APP_URL=set-me

# The wrangler login made for the client's Cloudflare account (wrangler auth create).
CF_PROFILE=sawariya

# The owner's sign-in name, used once by create-owner.sh.
OWNER_USERNAME=owner
